# Comanda — variáveis de ambiente de produção (deploy-vps).
# Copie para `.env`, preencha os valores reais e NUNCA versione o `.env` (já está no .gitignore).
# `application-prod.yaml` não tem default para nenhuma destas: boot falha com erro claro se faltar uma.

# --- Perfil ---
SPRING_PROFILES_ACTIVE=prod

# --- Banco (PostgreSQL 17, mesmo host — loopback/rede interna do compose) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/comanda
SPRING_DATASOURCE_USERNAME=comanda
SPRING_DATASOURCE_PASSWORD=

# Usadas pela própria imagem oficial do Postgres (docker-compose.yml, serviço `db`) para
# inicializar o banco/usuário — devem bater com as três variáveis acima.
POSTGRES_DB=comanda
POSTGRES_USER=comanda
POSTGRES_PASSWORD=

# --- JWT (auth stateless — access em memória, refresh em cookie httpOnly) ---
APP_JWT_SECRET=
APP_JWT_ACCESS_TTL_MINUTES=20
APP_JWT_REFRESH_TTL_DAYS=14

# --- Aplicação / multi-tenancy ---
# Domínio raiz; cada tenant vive em nomedonegocio.${APP_DOMAIN} atrás do wildcard do Caddy.
APP_DOMAIN=
# Base canônica usada em todas as URLs de tenant; normalmente igual a APP_DOMAIN.
VITE_TENANT_DOMAIN=
# Aliases de landing/preview separados por vírgula, compilados no frontend. Opcional.
VITE_ROOT_HOST_ALIASES=
# Caminho no disco do VPS onde as fotos de produto são gravadas (LocalDiskImageStorage).
APP_STORAGE_IMAGES_DIR=/var/comanda/uploads
# Token da superfície administrativa (ativação manual do plano Essencial). Vazio = endpoint /api/admin/** desligado.
APP_ADMIN_TOKEN=

# --- Rate limiting de autenticação (opcional — já tem default seguro em application.yaml) ---
APP_RATE_LIMIT_AUTH_CAPACITY=10
APP_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- SMTP transacional (provedor free tier — ex.: Brevo, Mailgun, Amazon SES) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Caddy: TLS wildcard via desafio DNS-01 ---
# Exemplo usa o provedor Cloudflare (deploy/Caddyfile); troque o token/plugin se usar outro provedor de DNS.
CLOUDFLARE_API_TOKEN=

# --- Backup diário do Postgres (deploy/backup/pg_dump_daily.sh) ---
# Nome do remote já configurado localmente via `rclone config` (bucket S3-compatível, outro host, etc.).
BACKUP_RCLONE_REMOTE=
BACKUP_RETENTION_DAYS=14
